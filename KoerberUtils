	public boolean verifyErrorMessageOfField(String field, String message1, String message2) {
		boolean flag = false;
		try {
			Log.message("Verifying error messages of field" + field);
			WebElement ele = DriverManager.getWrapperClass().waitForElementToBeVisible(
					DriverManager.getDriver().findElement(By.xpath(String.format(errorMessage, field))));
			WebElement ele1 = DriverManager.getWrapperClass().waitForElementToBeVisible(
					DriverManager.getDriver().findElement(By.xpath(String.format(errorMessage1, field))));
			flag = ele.getText().trim().equalsIgnoreCase(message1) && ele1.getText().trim().equalsIgnoreCase(message2);
			if (flag)
				Log.message("Error message verified successfully : " + message1 + message2);
		} catch (Exception e) {
			Log.message("Unable to verify error message of " + field + "" + e.getMessage());
		}

		return flag;
	}

