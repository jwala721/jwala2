	public Map<String, String> getFirstRowData() {
		Log.message("Getting First Row Data");
		Map<String, String> rowDataMap = new HashMap<String, String>();
		List<String> headers = getRowHeaders();
		try {
			for (int i = 0; i < headers.size(); i++) {
				String data = getRowCellDataUsingHeader("1", headers.get(i));
				Log.message(headers.get(i) + " : " + data);
				rowDataMap.put(headers.get(i), data);
			}
		} catch (Exception e) {
			Log.message("Unable to get column headers : " + e.getMessage());
		}
		return rowDataMap;
	}

	public String getRowCellDataUsingHeader(String rowNo, String headerName) {
		String data = null;
		int columnNumber = getColumnNumber(headerName);
		List<WebElement> ele = DriverManager.getDriver().findElements(By.xpath(String.format(row_Record, rowNo)));
		data = ele.get(columnNumber).getText();
		return data;
	}

	public String getRowNumberWhichHasHeaderData(String header) {
		String rowNum = "";
		String pageName = DriverManager.getWrapperClass().getText(lbl_pageName);
		Log.message("Getting row number from table " + pageName + " which has " + header);
		try {
			for (int i = 1; i <= lbl_rowCount.size(); i++) {
				String data = getRowCellDataUsingHeader(String.valueOf(i), header);
				if (!data.equalsIgnoreCase("") || data != null) {
					rowNum = String.valueOf(i);
					Log.message("Row " + i + " has " + header);
					break;
				}
			}
		} catch (Exception e) {
			Log.message("Unable to get row number from table " + pageName + "which has " + header + e.getMessage());
		}
		return rowNum;
	}

	public Map<String, String> getRowDataIfHeaderHasValue(String header) {
		Log.message("Getting Row Data if " + header + " has value");
		Map<String, String> rowDataMap = new HashMap<String, String>();
		List<String> headers = getRowHeaders();
		String rowNum = getRowNumberWhichHasHeaderData(header);
		try {
			for (int i = 0; i < headers.size(); i++) {
				String data = getRowCellDataUsingHeader(rowNum, headers.get(i));
				Log.message(headers.get(i) + " : " + data);
				rowDataMap.put(headers.get(i), data);
			}
		} catch (Exception e) {
			Log.message("Unable to get row Data if " + header + " has value : " + e.getMessage());
		}
		return rowDataMap;
	}

