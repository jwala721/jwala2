	public List<String> getRowHeaders() {
		Log.message("Getting Row headers");
		List<String> headers = new ArrayList<String>();
		try {
			for (WebElement headerEle : lst_ColumnHeaders) {
				headers.add(headerEle.getAttribute("data-title").trim());
			}
		} catch (Exception e) {
			Log.message("Unable to get column headers : " + e.getMessage());
		}
		return headers;
	}

	public int getColumnNumber(String header) {
		int colNum = 0;
		try {
			for (int i = 0; i < lst_ColumnHeaders.size(); i++) {
				String headerName = lst_ColumnHeaders.get(i).getAttribute("data-title").trim();
				if (headerName.equalsIgnoreCase(header)) {
					colNum = i;
					Log.message("Header column number of " + header + " " + colNum);
					break;
				}
			}
		} catch (Exception e) {
			Log.message("Unable to get column number");
		}
		return colNum;
	}

