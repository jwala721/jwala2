	public boolean getRowDetailsAndWriteInPropertyFile(String fileName, String header) {
		boolean flag = false;
		try {
			Map<String, String> rowData = getRowDataIfHeaderHasValue(header);
			rowData.put("Updated Expiration Date", DriverManager.getWrapperClass().getTargetDate());
			PropertyReader.getInstance().writeProperty(rowData, fileName);
			flag = true;
		} catch (Exception e) {
			Log.message("Unable to write row details in property file : " + e.getMessage());
		}
		return flag;
