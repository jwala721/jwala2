		public boolean nov_CsPickingNStaging() {
		    boolean success = false;
		    try {
		    	openMenuIfOnKorberHome();
		    	 // validate CHEP PALLETS REQUIRED screen
		        if (!chepPalletsRequiredLabel.isDisplayed()) {
		            Log.message("CHEP PALLETS REQUIRED label not displayed.");
		            return false;
		        }
		        Log.message("Clicking first Submit button.");
		        DriverManager.getWrapperClass().click(submitBtn);
		        DriverManager.getWrapperClass().waitForTimeOutInSec(2);
		        
		        Log.message("Clicking second Submit button.");
		        DriverManager.getWrapperClass().click(submitBtn);
		        DriverManager.getWrapperClass().waitForTimeOutInSec(2);
		        
		        // Enter Location
		        Log.message("Extracting and entering location.");
		        String reqLoc = extractAndEnterLocation(locationText);
		        koerberUtils.enterValueInField(reqLoc);
		        DriverManager.getWrapperClass().waitForTimeOutInSec(2);
		        
		        // Item   
		        Log.message("Extracting required item.");
		        String reqItem = extractAndEnterReqItem(locationText);
		        
		        // Lot   
		        DriverManager.getWrapperClass().waitForTimeOutInSec(2);
		        String lotNumber = dbutils.getLotNumber(reqItem, reqLoc);
		        Log.message("Retrieved Lot Number: " + lotNumber);
		        inputField.sendKeys(lotNumber);
		        Log.message("Entering lot number and clicking Submit.");
		        DriverManager.getWrapperClass().click(submitBtn);
		        
		        // Enter Quantity
		        DriverManager.getWrapperClass().waitForTimeOutInSec(2);
		        Log.message("Extracting and entering quantity for CS Pick.");
		        extractAndEnterQuantityCsPick(locationText);
		        
		        // Choose Printer   
		        DriverManager.getWrapperClass().waitForTimeOutInSec(2);
		        Log.message("Clicking List Function Key for printer selection.");
		        DriverManager.getWrapperClass().click(lstFunctionKey);
		        
		        // TESTK1 
		        DriverManager.getWrapperClass().waitForTimeOutInSec(2);
		        Log.message("Clicking TESTK1 Key.");
		        DriverManager.getWrapperClass().click(TESTK1_Key);
		        
		        // Print
		        DriverManager.getWrapperClass().waitForTimeOutInSec(2);
		        Log.message("Clicking Submit for print action.");
		        DriverManager.getWrapperClass().click(submitBtn);
		        
		        // Wrapping location   
		        DriverManager.getWrapperClass().waitForTimeOutInSec(2);
		        Log.message("Clicking Skip Function Key for wrapping location.");
		        DriverManager.getWrapperClass().click(skipFunctionKey);
		        
		        // Staging loc   
		        DriverManager.getWrapperClass().waitForTimeOutInSec(2);
		        String doorreqLOC = extractLocation(locationText);
		        Log.message("Extracting staging location: " + doorreqLOC);
		        koerberUtils.enterValueInField(doorreqLOC);
		        
		        // Transaction complete  
		        DriverManager.getWrapperClass().waitForTimeOutInSec(2);
		        Log.message("Clicking final Submit button to complete transaction.");
		        DriverManager.getWrapperClass().click(submitBtn);
		        DriverManager.getWrapperClass().waitForTimeOutInSec(2);
		        
		        Log.message("home_Depot_CsPickingNStaging completed successfully.");
		        success = true;
		        
		    } catch (Exception e) {
		        success = false;
		        Log.message("Exception in home_Depot_CsPickingNStaging: " + e.getMessage());
		    }
		    return success;
		}
		
