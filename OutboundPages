//	   location extraction and input

//	    String[] lines = locationText.getText().split("\\r?\\n");
	    String locationValue = null;

	    boolean orderLinePresent = false;
	    for (String line : lines) {
	        if (line != null && line.toLowerCase().contains("enter the staging location for order")) {
	            orderLinePresent = true;
	            break;
	        }
	    }

	    if (orderLinePresent) {
	        for (String line : lines) {
	            if (line == null) continue;
	            String trimmed = line.trim();
	            if (trimmed.toUpperCase().startsWith("LOC :")) {
	                String possibleLoc = trimmed.substring(trimmed.indexOf(":") + 1).trim();
	                if (possibleLoc.toUpperCase().matches("S\\d+")) {
	                    locationValue = possibleLoc.toUpperCase();
	                    break;
	                }
	            }
	        }
	        if (locationValue == null) {
	            locationValue = "S101";
	        }
	    } else {
	        for (int i = 0; i < lines.length; i++) {
	            if (lines[i] != null && lines[i].trim().equalsIgnoreCase("Go to location")) {
	                if (i + 1 < lines.length) {
	                    locationValue = lines[i + 1].trim();
	                    break;
	                }
	            }
	        }
	        if (locationValue == null || locationValue.isEmpty()) {
	            locationValue = "S101"; 
	        }
	    }
	    System.out.println("Location to enter: " + locationValue);
	    inputField.sendKeys(locationValue);
	    inputField.sendKeys(Keys.ENTER);

	 // --- Extract dynamic LP number ---
	    String lpRawText = lpTextElement.getText().trim(); 
	    System.out.println("Raw LP text: " + lpRawText);
	    String lpValue = "";
	    if (lpRawText.startsWith("LP:")) {
	        lpValue = lpRawText.substring(3).trim();
	    } else {
	        throw new RuntimeException("LP value not found in instruction block!");
	    }

	    System.out.println("Dynamic LP to enter: " + lpValue);
	    inputField.sendKeys(lpValue);
	    inputField.sendKeys(Keys.ENTER);
	    DriverManager.getWrapperClass().waitForTimeOutInSec(2);
	    
	 // Transaction complete
	    DriverManager.getWrapperClass().click(submitBtn);

	}
	
