					DriverManager.getWrapperClass().enterTextByElement(inputField, "Y");
					DriverManager.getWrapperClass().waitForTimeOutInSec(2);
					inputField.sendKeys(Keys.ENTER);
					confirmHandled = true;
				}
				DriverManager.getWrapperClass().logValidation(confirmHandled, "Confirm message handled");

				// --- Step 2: Enter Door and Trailer ---
				DriverManager.getWrapperClass().waitForTimeOutInSec(3);
				DriverManager.getWrapperClass().enterTextByElement(inputField, doorGlo);
				DriverManager.getWrapperClass().waitForTimeOutInSec(2);
				inputField.sendKeys(Keys.ENTER);
				DriverManager.getWrapperClass().waitForTimeOutInSec(3);

				DriverManager.getWrapperClass().enterTextByElement(inputField, trailerNumber);
				DriverManager.getWrapperClass().waitForTimeOutInSec(2);
				inputField.sendKeys(Keys.ENTER);
				DriverManager.getWrapperClass().waitForTimeOutInSec(5);

				// Wait until LP field potentially appears (defensive)
				DriverManager.getWrapperClass().waitForElementToBeVisible(LP_Text);

				// --- Step 3: Scan LP #1 ---
				String lp1TextBlock = locationText.getText();
