		public String extractLocation(WebElement locationTextElement) {
		    String[] lines = locationTextElement.getText().split("\\r?\\n");
		    String locationValue = null;
		    boolean orderLinePresent = false;

		    for (String line : lines) {
		        if (line != null && line.toLowerCase().contains("enter the staging location for order")) {
		            orderLinePresent = true;
		            break;
		        }
		    }
		    if (orderLinePresent) {
		        for (String line : lines) {
		            if (line == null) continue;
		            String trimmed = line.trim();
		            if (trimmed.toUpperCase().startsWith("LOC :")) {
		                String possibleLoc = trimmed.substring(trimmed.indexOf(":") + 1).trim();
		                if (possibleLoc.toUpperCase().matches("S\\d+")) {
		                    locationValue = possibleLoc.toUpperCase();
		                    break;
		                }
		            }
		        }
		        if (locationValue == null) {
		            locationValue = "S101";
		        }
		    } else {
		        for (int i = 0; i < lines.length; i++) {
		            if (lines[i] != null && lines[i].trim().equalsIgnoreCase("Go to location")) {
		                if (i + 1 < lines.length) {
		                    locationValue = lines[i + 1].trim();
		                    break;
		                }
		            }
		        }
		        if (locationValue == null || locationValue.isEmpty()) {
		            locationValue = "S101";
		        }
		    }
		    Log.message("Location to enter: " + locationValue);
		    return locationValue;
		}
		
