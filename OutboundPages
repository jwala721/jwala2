		// Generic retry method to check element visibility with retries and waits
	    public boolean waitForElementVisibleWithRetries(Supplier<WebElement> elementSupplier, int maxAttempts, int waitSecondsBetween) {
	        int attempts = 0;
	        boolean isVisible = false;
	        while (attempts < maxAttempts && !isVisible) {
	            try {
	                WebElement element = elementSupplier.get();
	                isVisible = element.isDisplayed();
	            } catch (NoSuchElementException | StaleElementReferenceException e) {
	                isVisible = false;
	            }
	            if (!isVisible) {
	                DriverManager.getWrapperClass().click(mainNavigation.f1BackFunctionKey);
	                DriverManager.getWrapperClass().waitForTimeOutInSec(waitSecondsBetween);
	            }
	            attempts++;
	        }
	        return isVisible;
	    }

		
