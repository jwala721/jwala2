	public boolean selectTibcoLoadId(String tibcoLoadID) {
		boolean flag = false;
		try {
		DriverManager.getWrapperClass().click(tibcoLoadIdField);
		tibcoLoadIdFieldValue.sendKeys(tibcoLoadID);
		tibcoLoadIdFieldValue.sendKeys(Keys.ENTER);
		boolean newStatusVisible = newStatus.isDisplayed();

		if (newStatusVisible) {
			ExtentCucumberAdapter.addTestStepLog("✅ New status is displayed");
		} else {
			ExtentCucumberAdapter.addTestStepLog("❌ New status is NOT displayed");
		}
		loadId = viewLoadLoadId.getText();
		System.out.println("loadId   " + loadId);

		DriverManager.getWrapperClass().click(release);
		DriverManager.getWrapperClass().waitForElementToBeVisible(priorityTextInput);		
		koerberUtils.scrollClearAndType(priorityTextInput, "90");	
		DriverManager.getWrapperClass().click(release);
		DriverManager.getWrapperClass().waitForTimeOutInSec(20);
		DriverManager.getWrapperClass().clickWithJS(inventoryPages.refresh_page);
		DriverManager.getWrapperClass().clickWithJS(inventoryPages.refresh_page);
		DriverManager.getWrapperClass().waitForTimeOutInSec(3);

		boolean releasedStatusVisible = releasedStatus.isDisplayed();
        if (releasedStatusVisible) {
            ExtentCucumberAdapter.addTestStepLog("Verified the released status of new load");
        } else {
            ExtentCucumberAdapter.addTestStepLog("Released status is not displayed");
        }
        
        flag = newStatusVisible && releasedStatusVisible;
		}

		catch (Exception e) {
        ExtentCucumberAdapter.addTestStepLog("Exception occurred: " + e.getMessage());
        flag = false;
    }
    return flag;

	}

