		public boolean Full_loading_Process() {
			boolean flag = false; // start as false; set true only when all validations pass

			try {
				// --- Step 0: Ensure 'Loading' button visible (with back retries) ---
				int attempts = 0;
				boolean loadingBtnVisible = false;
				while (attempts < 4 && !loadingBtnVisible) {
					try {
						loadingBtnVisible = mainNavigation.loadingButtonK1Mobile.isDisplayed();
					} catch (NoSuchElementException | StaleElementReferenceException e) {
						loadingBtnVisible = false;
					}
					if (!loadingBtnVisible) {
						DriverManager.getWrapperClass().click(mainNavigation.f1BackFunctionKey);
						DriverManager.getWrapperClass().waitForTimeOutInSec(2);
					}
					attempts++;
				}

				DriverManager.getWrapperClass().logValidation(loadingBtnVisible, "Loading button is displayed");
				if (!loadingBtnVisible) {
					// Early exit if critical UI entry point is missing
					return false;
				}

				// --- Step 1: Click 'Loading' & enter Load ID ---
				DriverManager.getWrapperClass().click(mainNavigation.loadingButtonK1Mobile);
				DriverManager.getWrapperClass().waitForTimeOutInSec(2);

				DriverManager.getWrapperClass().enterTextByElement(inputField, loadId);
